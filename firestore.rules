rules_version = '2';
// Chỉ những email trong danh sách dưới đây mới đọc/ghi được dữ liệu của quán.
// Thay hai email ví dụ bằng email thật của bạn và người cùng làm, rồi dán vào
// Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['email-cua-ban@gmail.com', 'email-ban-cung-lam@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
